{
  "name": "leadrescue",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:load": "node scripts/loadtest-run.mjs",
    "db:benchmark": "node --import=tsx scripts/db-performance/benchmark.ts",
    "worker": "node --conditions=react-server --import=tsx scripts/worker.mjs",
    "db:migrate": "node --import=tsx scripts/migrate.ts",
    "check:env": "node scripts/runtime-env.mjs",
    "check:secrets": "powershell -NoProfile -File scripts/scan-secrets.ps1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "jose": "6.2.14",
    "lucide-react": "1.70.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "stripe": "23.1.0",
    "twilio": "6.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
