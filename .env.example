# Copy to .env.local. Enter secrets only in your editor or hosting secret manager.
# Blank credentials disable real account access in development. Do not use demo as auth.
APP_ORIGIN=http://127.0.0.1:3000
DEMO_MODE=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_COOKIE_SECRET=

# PostgreSQL direct/session endpoint, restricted worker role; TLS required in production.
DATABASE_URL=
WORKER_HEALTH_PORT=3001
TRUST_PROXY=false
TRUSTED_CLIENT_IP_HEADER=

# Enable a capability only after its secrets, approvals and staging tests are ready.
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_ORIGIN=
APPROVED_US_FORWARD_DESTINATIONS=
PLATFORM_DAILY_SMS_SEGMENT_LIMIT=1000

AI_ENABLED=false
OPENAI_API_KEY=
# Pin an approved model snapshot; no default silently changes in production.
OPENAI_MODEL=
AI_MAX_CALL_COST_MINOR=5
PLATFORM_DAILY_AI_COST_LIMIT_MINOR=1000

BILLING_ENABLED=false
BILLING_LIVE_APPROVED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
PLAN_MONTHLY_PRICE_MINOR=29900
PLAN_PAID_SMS_LIMIT=500
PLAN_PAID_AI_LIMIT=500

CALENDAR_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Authenticated encryption: locally generated base64 32-byte key; keep secret.
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_VERSION=v1

NOTIFICATIONS_ENABLED=false
# Notifications currently persist to the team inbox. No external mail provider is implied.
OPERATOR_MAINTENANCE_ENABLED=false
OPERATOR_ID=
